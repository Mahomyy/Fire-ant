    (define (waarde? A i j)
      (vector-ref (vector-ref A i) j))
    
    (define (juiste-doolhof richting-soort positie-soort doolhof)
     (cond
                  ((eq? richting-soort 'omhoog)
                   (cond ((= (waarde? doolhof  (- (positie-soort 'y) 1) (positie-soort 'x)) 0) positie-soort) ;wanneer de waarde van de element in de vector van vectoren 0 is op een bepaald positie, mag de vuurmier of schorpioen daar niet heen gaan, wel wanneer het element een 1 is
                         ((= (waarde? doolhof (positie-soort 'y) (positie-soort 'x)) 1)                            ;ik kijk eigenlijk naar de volgende positie vooraleer de vuurmier of de schorpioen naar die positie verplaats wordt.
                          (maak-positie (positie-soort 'x)(- (positie-soort 'y) 1)))))
                  ((eq? richting-soort 'omlaag)
                   (cond ((= (waarde? doolhof (+ (positie-soort 'y) 1) (positie-soort 'x)) 0) positie-soort)
                         ((= (waarde? doolhof  (positie-soort 'y) (positie-soort 'x)) 1)
                          (maak-positie (positie-soort 'x)(+ (positie-soort 'y) 1)))))
                  ((eq? richting-soort 'links)
                   (cond ((= (waarde? doolhof (positie-soort 'y) (- (positie-soort 'x) 1)) 0) positie-soort)
                         ((= (waarde? doolhof (positie-soort 'y) (positie-soort 'x)) 1)
                          (maak-positie (- (positie-soort 'x) 1)(positie-soort 'y)))))
     
                  ((eq? richting-soort 'rechts)
                   (cond ((= (waarde? doolhof (positie-soort 'y) (+ (positie-soort 'x) 1)) 0) positie-soort)
                         ((= (waarde? doolhof  (positie-soort 'y) (positie-soort 'x)) 1)
                          (maak-positie (+(positie-soort 'x)1)(positie-soort 'y)))))))
     
